#!/bin/sh
# Refuse to push commits (not yet on the remote) whose author/committer e-mail is not a noreply address.
# Commits already on the remote are not checked.
z=0000000000000000000000000000000000000000
while read lref lsha rref rsha; do
  [ "$lsha" = "$z" ] && continue
  if [ "$rsha" = "$z" ]; then range="$lsha --not --remotes"; else range="$rsha..$lsha"; fi
  bad=$(git log --format='%h %ae %ce' $range | awk '{ for (i=2;i<=3;i++) if ($i !~ /@users\.noreply\.github\.com$/ && $i != "noreply@anthropic.com") { print; break } }')
  if [ -n "$bad" ]; then
    echo "푸시 거부: 실제 이메일이 들어간 커밋이 있습니다 (공개 저장소)." >&2
    echo "$bad" >&2
    echo "고치는 법: git config user.email \"124869504+Marhnie@users.noreply.github.com\" 후 git commit --amend --reset-author (여러 개면 rebase)" >&2
    exit 1
  fi
done
exit 0
