#!/bin/sh
# Refuse commits whose author/committer e-mail is not a GitHub noreply address (this repository is public).
# Enable once per clone:  git config core.hooksPath .githooks      (server/setup.py does it)
# Set the address:        git config user.email "124869504+Marhnie@users.noreply.github.com"
for who in AUTHOR COMMITTER; do
  ident=$(git var GIT_${who}_IDENT 2>/dev/null) || continue
  email=$(printf '%s' "$ident" | sed -n 's/.*<\(.*\)>.*/\1/p')
  case "$email" in
    *@users.noreply.github.com|noreply@anthropic.com) ;;
    *) echo "커밋 거부: ${who} 이메일이 공개 저장소에 노출됩니다 ($email)." >&2
       echo "  git config user.email \"124869504+Marhnie@users.noreply.github.com\"" >&2
       exit 1 ;;
  esac
done
exit 0
